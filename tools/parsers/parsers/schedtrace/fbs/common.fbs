namespace ocudu.schedtrace.fbs;

enum CyclicPrefix : uint8 {
  Normal = 0,
  Extended = 1,
}

enum SubcarrierSpacing : uint8 {
  Khz15 = 0,
  Khz30 = 1,
  Khz60 = 2,
  Khz120 = 3,
  Khz240 = 4,
}

/// Contiguous range of CRBs, relative to Point A.
struct CrbInterval {
  start: uint16;
  length: uint16;
}

/// Generic parameters of a bandwidth part.
struct BwpConfiguration {
  cp: CyclicPrefix;
  scs: SubcarrierSpacing;
  crbs: CrbInterval;
}
