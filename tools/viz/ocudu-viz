# Runs ocudu-viz in a container. Builds the image when needed, mounts the home and temp directories (and
# any given roots or file directories) read-only at their host paths, keeps the parse cache in a per-user
# directory under the temp dir, publishes the server on the host loopback only and opens the browser.

set -euo pipefail

readonly IMAGE="ocudu-viz:latest"
readonly DOCKER="${OCUDU_VIZ_DOCKER:-docker}"
script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly script_dir

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] [FILE...]

Opens OCUDU artifacts (e.g. gnb.log, du.log) in ocudu-viz, running in a container. Files can also be
opened from the page, within the mounted directories.

Options:
  --port N          Host port to serve on, or the next free one (default: 8765).
  --root DIR        Also mount DIR read-only and allow opening its files from the page, e.g. a shared
                    artifacts directory. Repeatable. The home and temp (\$TMPDIR or /tmp)
                    directories are always mounted read-only.
  --no-browser      Do not open the browser.
  --rebuild         Rebuild the image from scratch, without the build cache.
  --cache-size GB   Parse cache size limit (default: 2).
  --no-cache        Keep parsed data in memory only.
  --clear-cache     Remove all parse caches before starting.
  -h, --help        Show this help.

Environment:
  OCUDU_VIZ_DOCKER  Container engine command (default: docker), e.g. podman.
EOF
}

die() {
  echo "ocudu-viz: $*" >&2
  exit 2
}

port=8765
open_browser=1
rebuild=0
tmp_root="$(readlink -f "${TMPDIR:-/tmp}")"
roots=("$(readlink -f "$HOME")")
# gnb logs are often written to the temp dir, unless it is already within the home directory.
[[ "$tmp_root" == "${roots[0]}" || "$tmp_root" == "${roots[0]}"/* ]] || roots+=("$tmp_root")
server_args=()
files=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --port) port="${2:?--port needs a value}"; shift 2 ;;
    --root) roots+=("$(readlink -f "${2:?--root needs a value}")"); shift 2 ;;
    --no-browser) open_browser=0; shift ;;
    --rebuild) rebuild=1; shift ;;
    --cache-size) server_args+=(--cache-size "${2:?--cache-size needs a value}"); shift 2 ;;
    --no-cache|--clear-cache) server_args+=("$1"); shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; files+=("$@"); break ;;
    -*) die "unknown option $1 (see --help)" ;;
    *) files+=("$1"); shift ;;
  esac
done

command -v "$DOCKER" >/dev/null || die "$DOCKER not found. Install Docker, or set OCUDU_VIZ_DOCKER (e.g. to podman)."

# Files are passed to the container by their absolute host paths, which the mounts below keep valid.
abs_files=()
for f in "${files[@]}"; do
  [[ -f "$f" ]] || die "$f: not a file"
  abs_files+=("$(readlink -f "$f")")
done
# The image is built on every run: unchanged sources hit the build cache and take a second or two.
build_args=(--quiet)
[[ $rebuild -eq 1 ]] && build_args+=(--no-cache)
echo "Building the ocudu-viz image..." >&2
"$DOCKER" build "${build_args[@]}" -t "$IMAGE" -f "$script_dir/Dockerfile" "$script_dir/.." >/dev/null

# Mounts: the roots, plus the directory of any file outside them, all read-only at the same path.
mounts=()
for r in "${roots[@]}"; do
  mounts+=(-v "$r:$r:ro")
done
for f in "${abs_files[@]}"; do
  covered=0
  for r in "${roots[@]}"; do
    [[ "$f" == "$r"/* ]] && covered=1 && break
  done
  if [[ $covered -eq 0 ]]; then
    d="$(dirname "$f")"
    roots+=("$d")
    mounts+=(-v "$d:$d:ro")
  fi
done

# The server lets the page open files in the mounted directories only.
for r in "${roots[@]}"; do
  server_args+=(--root "$r")
done

cache_dir="${TMPDIR:-/tmp}/ocudu-viz-$(id -u)"
mkdir -p -m 700 "$cache_dir"

port_busy() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}
while port_busy "$port"; do
  port=$((port + 1))
done
url="http://127.0.0.1:$port/"

if [[ $open_browser -eq 1 ]]; then
  # Opens the browser once the server listens, which is after the given files are parsed.
  (
    until port_busy "$port"; do
      sleep 1
    done
    xdg-open "$url" >/dev/null 2>&1 || open "$url" >/dev/null 2>&1 || true
  ) &
  browser_pid=$!
  trap 'kill "$browser_pid" 2>/dev/null || true' EXIT
fi

tty_args=()
[[ -t 0 && -t 1 ]] && tty_args=(-it)
"$DOCKER" run --rm --init "${tty_args[@]}" \
  --user "$(id -u):$(id -g)" \
  -p "127.0.0.1:$port:$port" \
  "${mounts[@]}" \
  -v "$cache_dir:$cache_dir" \
  "$IMAGE" --port "$port" --cache-dir "$cache_dir" "${server_args[@]}" "${abs_files[@]}"
